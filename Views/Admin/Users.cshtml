@model List<AppUser>
@{ ViewData["Title"] = "Users"; }
<div class="wrap pb-5"><div class="page-head"><h2>Users</h2><p>@Model.Count registered account(s)</p></div>
<div class="panel p-0"><div class="table-responsive"><table class="table align-middle mb-0">
<thead><tr><th class="ps-4">Name</th><th>Email</th><th>Role</th><th>Joined</th><th class="pe-4"></th></tr></thead><tbody>
@foreach (var u in Model) {
<tr><td class="ps-4 fw-semibold">@u.Name</td><td>@u.Email</td><td><span class="role @(u.Role == "Admin" ? "adm" : "")">@u.Role</span></td><td>@u.CreatedOn.ToString("dd MMM yyyy")</td>
<td class="pe-4 text-end">@if (u.Role != "Admin") { <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" onsubmit="return confirm('Remove this user?')"><button class="btn btn-sm btn-line text-danger">Remove</button></form> }</td></tr> }
</tbody></table></div></div></div>
