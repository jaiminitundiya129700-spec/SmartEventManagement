@model RegisterVm
@{ ViewData["Title"] = "Sign up"; }
<div class="auth"><div class="auth-card">
 <div class="logo"><i class="bi bi-person-plus"></i></div>
 <h2>Create your account</h2><p class="text-muted">Sign up to start booking events in seconds.</p>
 <form asp-action="Register" method="post">
  <div asp-validation-summary="All" class="text-danger small mb-2"></div>
  <div class="mb-3"><label asp-for="Name" class="form-label">Full name</label><input asp-for="Name" class="form-control" placeholder="Your name"></div>
  <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="you@example.com"></div>
  <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" placeholder="At least 6 characters"></div>
  <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password"></div>
  <button class="btn btn-brand w-100 py-2">Sign up</button>
 </form>
 <p class="text-center text-muted mt-3 mb-0">Already have an account? <a asp-action="Login" class="fw-semibold">Log in</a></p>
</div></div>
